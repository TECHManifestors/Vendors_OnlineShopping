@model Product
@{
    ViewData["Title"] = "Confirm Purchase";
}

<div class="container">
    <div class="auth-wrap wide">
        <h2>Confirm Your Order</h2>

        <div class="product-card" style="margin-bottom:1.5rem;">
            <div class="product-card-body">
                <span class="category-tag">@Model.Category?.Name</span>
                <h3>@Model.ProductName</h3>
                <p style="font-size:0.85rem; color:var(--neutral-700);">Sold by @Model.Vendor?.BusinessName</p>
                <div class="price">R@(Model.Price.ToString("0.00")) each</div>
                <p style="font-size:0.85rem; color:var(--neutral-700);">@Model.StockQuantity available</p>
            </div>
        </div>

        <form asp-action="Buy" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="productId" value="@Model.ProductId" />

            <div class="form-group">
                <label for="quantity">Quantity</label>
                <input type="number" id="quantity" name="quantity" class="form-control"
                       value="1" min="1" max="@Model.StockQuantity" />
            </div>

            <button type="submit" class="btn-submit">Proceed to Payment</button>
        </form>

        <div class="auth-links">
            <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.ProductId">&larr; Back to Product</a>
        </div>
    </div>
</div>
