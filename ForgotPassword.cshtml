@model ForgotPasswordViewModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container">
    <div class="auth-wrap">
        <h2>Forgot Password</h2>
        <p class="subtitle">Enter the email address linked to your account and we'll send you a secure link to reset your password.</p>

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <form asp-controller="Account" asp-action="ForgotPassword" method="post" novalidate>
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" autocomplete="email" autofocus />
                <span asp-validation-for="Email" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn-submit">Send Reset Link</button>
        </form>

        <div class="auth-links">
            <a asp-controller="Account" asp-action="Login">Back to Log In</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
