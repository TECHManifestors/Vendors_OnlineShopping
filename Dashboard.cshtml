@model Vendor
@{
    ViewData["Title"] = "Vendor Dashboard";
}

<div class="container">
    <h2 class="section-title">Vendor Dashboard</h2>

    @if (!Model.IsApproved)
    {
        <div class="alert alert-info">
            Your vendor account is pending Administrator approval. You can still add products, but they
            will only be visible to customers once your account is approved.
        </div>
    }

    <div class="card-grid" style="grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));">
        <div class="product-card">
            <div class="product-card-body">
                <h3>Business Details</h3>
                <p style="font-size:0.9rem; color:var(--neutral-700); margin:0.2rem 0;"><strong>@Model.BusinessName</strong></p>
                <p style="font-size:0.85rem; color:var(--neutral-700); margin:0.2rem 0;">@Model.Email</p>
                <p style="font-size:0.85rem; color:var(--neutral-700); margin:0.2rem 0;">@Model.PhoneNumber</p>
                <p style="font-size:0.85rem; color:var(--neutral-700); margin:0.2rem 0;">@Model.BusinessAddress</p>
            </div>
        </div>

        <div class="product-card">
            <div class="product-card-body">
                <h3>Products Listed</h3>
                <div class="price" style="font-size:1.8rem;">@Model.Products.Count</div>
                <a asp-controller="Product" asp-action="MyProducts">Manage Products &rarr;</a>
            </div>
        </div>

        <div class="product-card">
            <div class="product-card-body">
                <h3>Quick Action</h3>
                <p style="font-size:0.85rem; color:var(--neutral-700);">List a new item on the marketplace.</p>
                <a asp-controller="Product" asp-action="Create" class="btn-nav" style="background:var(--brand-primary); color:#fff !important; display:inline-block; margin-top:0.4rem;">+ Add Product</a>
            </div>
        </div>
    </div>
</div>
