@model Product
@{
    ViewData["Title"] = "Add Product";
    var categories = ViewBag.Categories as List<Category>;
}

<div class="container">
    <div class="auth-wrap wide">
        <h2>Add a New Product</h2>
        <p class="subtitle">This product will appear in the marketplace once saved.</p>

        <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>

        <form asp-action="Create" method="post" enctype="multipart/form-data" novalidate>
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="ImageFile">Product Image (optional)</label>
                <input asp-for="ImageFile" class="form-control" type="file" accept=".jpg,.jpeg,.png,.webp" />
                <span asp-validation-for="ImageFile" class="field-validation-error"></span>
                <small style="color:var(--neutral-700);">JPG, PNG, or WEBP — up to 5 MB.</small>
            </div>

            <div class="form-group">
                <label asp-for="ProductName"></label>
                <input asp-for="ProductName" class="form-control" />
                <span asp-validation-for="ProductName" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="CategoryId">Category</label>
                <select asp-for="CategoryId" class="form-control">
                    <option value="">-- Select a category --</option>
                    @if (categories != null)
                    {
                        foreach (var cat in categories)
                        {
                            <option value="@cat.CategoryId">@cat.Name</option>
                        }
                    }
                </select>
                <span asp-validation-for="CategoryId" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Price">Price (ZAR)</label>
                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="Price" class="field-validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="StockQuantity"></label>
                <input asp-for="StockQuantity" class="form-control" type="number" min="0" />
                <span asp-validation-for="StockQuantity" class="field-validation-error"></span>
            </div>

            <button type="submit" class="btn-submit">Save Product</button>
        </form>

        <div class="auth-links">
            <a asp-action="MyProducts">&larr; Back to My Products</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
