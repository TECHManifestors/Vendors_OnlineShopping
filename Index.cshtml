@model List<Product>
@{
    ViewData["Title"] = "Products";
    var categories = ViewBag.Categories as List<Category>;
    int? selectedId = ViewBag.SelectedCategoryId;
}

<div class="container">
    <h2 class="section-title">Browse Products</h2>

    <div style="margin-bottom:1.5rem; display:flex; gap:0.5rem; flex-wrap:wrap;">
        <a asp-action="Index"
           class="btn-nav"
           style="background:@(selectedId == null ? "var(--brand-primary)" : "var(--neutral-300)"); color:@(selectedId == null ? "#fff" : "#1c2a2a") !important;">
            All
        </a>
        @if (categories != null)
        {
            foreach (var cat in categories)
            {
                <a asp-action="Index" asp-route-categoryId="@cat.CategoryId"
                   class="btn-nav"
                   style="background:@(selectedId == cat.CategoryId ? "var(--brand-primary)" : "var(--neutral-300)"); color:@(selectedId == cat.CategoryId ? "#fff" : "#1c2a2a") !important;">
                    @cat.Name
                </a>
            }
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No products found in this category yet. Check back soon.</div>
    }
    else
    {
        <div class="card-grid">
            @foreach (var product in Model)
            {
                <div class="product-card">
                    <div class="product-card-media">
                        <div class="cat-icon @product.Category?.IconClass">
                            @(product.Category?.Name.Substring(0, 1) ?? "P")
                        </div>
                    </div>
                    <div class="product-card-body">
                        <span class="category-tag">@product.Category?.Name</span>
                        <h3>@product.ProductName</h3>
                        <p style="font-size:0.85rem; color:var(--neutral-700); margin:0 0 0.4rem;">
                            Sold by @product.Vendor?.BusinessName
                        </p>
                        <div class="price">R@(product.Price.ToString("0.00"))</div>
                        <a asp-action="Details" asp-route-id="@product.ProductId">View Details</a>
                    </div>
                </div>
            }
        </div>
    }
</div>
