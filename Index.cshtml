@model List<Product>
@{
    ViewData["Title"] = "Products";
    var categories = ViewBag.Categories as List<Category>;
    int? selectedId = ViewBag.SelectedCategoryId;
}

<div class="container">
    <h2 class="section-title">Browse Products</h2>

    <form asp-action="Index" method="get" role="search" style="margin-bottom:1rem; display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center;">
        @if (selectedId.HasValue)
        {
            <input type="hidden" name="categoryId" value="@selectedId" />
        }
        <input type="text" name="searchTerm" value="@(ViewBag.SearchTerm as string)"
               placeholder="Search products, categories, or vendors..."
               class="form-control" style="max-width:320px; margin:0;" />
        <button type="submit" class="btn-nav" style="background:var(--brand-primary); color:#fff !important;">Search</button>
        @if (!string.IsNullOrWhiteSpace(ViewBag.SearchTerm as string))
        {
            <a asp-action="Index" asp-route-categoryId="@selectedId" class="btn-nav" style="background:var(--neutral-300); color:#1c2a2a !important;">Clear Search</a>
        }
    </form>

    <div style="margin-bottom:1.5rem; display:flex; gap:0.5rem; flex-wrap:wrap;">
        <a asp-action="Index" asp-route-searchTerm="@(ViewBag.SearchTerm as string)"
           class="btn-nav"
           style="background:@(selectedId == null ? "var(--brand-primary)" : "var(--neutral-300)"); color:@(selectedId == null ? "#fff" : "#1c2a2a") !important;">
            All
        </a>
        @if (categories != null)
        {
            foreach (var cat in categories)
            {
                <a asp-action="Index" asp-route-categoryId="@cat.CategoryId" asp-route-searchTerm="@(ViewBag.SearchTerm as string)"
                   class="btn-nav"
                   style="background:@(selectedId == cat.CategoryId ? "var(--brand-primary)" : "var(--neutral-300)"); color:@(selectedId == cat.CategoryId ? "#fff" : "#1c2a2a") !important;">
                    @cat.Name
                </a>
            }
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">No products found. Try a different search term or category.</div>
    }
    else
    {
        <div class="card-grid">
            @foreach (var product in Model)
            {
                <div class="product-card">
                    <div class="product-card-media">
                        @if (!string.IsNullOrEmpty(product.ImagePath))
                        {
                            <img src="@product.ImagePath" alt="@product.ProductName" class="product-image" />
                        }
                        else
                        {
                            <div class="cat-icon @product.Category?.IconClass">
                                @(product.Category?.Name.Substring(0, 1) ?? "P")
                            </div>
                        }
                    </div>
                    <div class="product-card-body">
                        <span class="category-tag">@product.Category?.Name</span>
                        <h3>@product.ProductName</h3>
                        <p style="font-size:0.85rem; color:var(--neutral-700); margin:0 0 0.4rem;">
                            Sold by @product.Vendor?.BusinessName
                        </p>
                        <div class="price">R@(product.Price.ToString("0.00"))</div>
                        <a asp-action="Details" asp-route-id="@product.ProductId">View Details</a>
                    </div>
                </div>
            }
        </div>
    }
</div>
