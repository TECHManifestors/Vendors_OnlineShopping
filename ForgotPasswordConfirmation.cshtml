@{
    ViewData["Title"] = "Check Your Email";
}

<div class="container">
    <div class="auth-wrap">
        <h2>Check Your Email</h2>
        <div class="alert alert-info">
            If an account exists for that email address, we've sent a link to reset your password.
            The link will expire in 2 hours.
        </div>
        <p class="subtitle" style="margin-top:1rem;">
            Didn't receive anything? Check your spam folder, or make sure you registered using this
            email address.
        </p>
        <div class="auth-links">
            <a asp-controller="Account" asp-action="Login">Back to Log In</a>
        </div>
    </div>
</div>
