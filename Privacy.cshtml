@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container">
    <div class="auth-wrap wide">
        <h2>Privacy Policy</h2>
        <p>
            VendorShop Online collects only the personal information necessary to operate the
            marketplace: full name, email address, phone number, and delivery/business address.
            This aligns with the data minimisation principle set out in South Africa's Protection
            of Personal Information Act (POPIA).
        </p>
        <p>
            Passwords are never stored in plain text. All passwords are hashed using ASP.NET Core
            Identity's PBKDF2-based hashing algorithm with a unique salt per user. Password reset
            links contain a single-use, time-limited token and expire automatically after 2 hours.
        </p>
        <p>
            Personal information is used solely to facilitate registration, order fulfilment, and
            account recovery, and is not shared with third parties beyond what is required to
            deliver these services.
        </p>
    </div>
</div>
